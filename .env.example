# ==========================================
# Authentication (Passwordless / JWT)
# ==========================================
JWT_SECRET="dev-secret-change-in-prod"
RESEND_API_KEY="re_123456789"
EMAIL_FROM="noreply@yourdomain.com"

# ==========================================
# PatchCTL metadata database (server only)
# ==========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/corely?schema=public"

# ==========================================
# Customer source database (local CLI fallback only)
# ==========================================
# Prefer `patchctl connect postgres`, which stores the DSN in the OS credential
# backend. Set this only in CI/disposable environments; PatchCTL never persists
# or uploads it. Do not configure a hosted deployment with a customer source DSN.
# PATCHCTL_DATABASE_URL="postgresql://source_user:source_password@localhost:5432/content"
